     {
      "re": "(?:Budget[ \\t]+)?Fastbreak[ \\t]*(?:Number|No\\.?|#)?[ \\t]*(?:[:#]|\\t)[ \\t]*([A-Z0-9][A-Z0-9-]{3,})",
      "set": {
       "loyalty.program": "Budget Fastbreak"
      }
     }
    ]
   }
  },
  "enterprise": {
   "name": "Enterprise",
