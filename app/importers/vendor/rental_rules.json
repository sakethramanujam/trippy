{
 "_comment": "Shared receipt-parsing rules. Used verbatim by js/parsers/engine.js (browser + Node tests) and tools/import_receipts.py. Regexes must stay in the JS/Python common subset: numbered groups only, no inline flags, no \\Z/\\A, use [\\s\\S] instead of dot-all. All patterns are compiled case-insensitive + multiline.",
 "version": 1,
 "detectIgnore": [
  "Avis[ \\t]+Budget[ \\t]+(?:Group|Car[ \\t]+Rental|Rental)",
  "Enterprise[ \\t]+Holdings",
  "Enterprise[ \\t]+Mobility"
 ],
 "companies": {
  "avis": {
   "name": "Avis",
   "detect": [
    {
     "re": "\\bAvis\\b",
     "w": 1
    },
    {
     "re": "avis\\.com",
     "w": 2
    },
    {
     "re": "Avis[ \\t]+Preferred",
     "w": 3
    }
   ],
   "fields": {
    "loyalty.number": [
     {
      "re": "Avis[ \\t]+Preferred(?:[ \\t]+Plus)?[ \\t]*(?:Number|No\\.?|#)?[ \\t]*(?:[:#]|\\t)[ \\t]*([A-Z0-9][A-Z0-9-]{3,})",
      "set": {
       "loyalty.program": "Avis Preferred"
      }
     }
    ],
    "confirmation": [
     "\\bAvis[ \\t]+Confirmation[ \\t]+Number[ \\t]*:[ \\t]*([A-Z0-9]{6,})\\b"
    ],
    "vehicle.description": [
     {
      "re": "\\bYour[ \\t]+(White|Black|Silver|Gray|Grey|Blue|Red|Green|Brown|Beige|Gold|Orange|Yellow|Purple|Maroon|Tan)?[ \\t]*([A-Z][A-Z0-9-]*(?:[ \\t]+[A-Z0-9-]+)*)[ \\t]+is[ \\t]+ready\\b",
      "groups": {
       "vehicle.color": 1,
       "vehicle.description": 2
      }
     }
    ],
    "vehicle.plate": [
     "License[ \\t]+plate[ \\t]*#[ \\t]*([A-Z0-9]{2,8})\\b"
    ],
    "vehicle.class": [
     "^[ \\t]*(?:YOUR[ \\t]+CAR|Vehicle)[ \\t]*\\n(?:[ \\t]*\\n)*[ \\t]*([^\\n]+?[ \\t]+or[ \\t]+similar)[ \\t]*$",
     "^[ \\t]*Vehicle[ \\t]*\\n[ \\t]*([^\\n]+?[ \\t]+or[ \\t]+similar)[ \\t]*$",
     "^[ \\t]*Avis[ \\t]+-[ \\t]+([^\\n]+?)[ \\t]*$"
    ],
    "pickup.location": [
     "^[ \\t]*Welcome[ \\t]+to[ \\t]+([A-Z][^\\n.]{2,60}?)\\.[ \\t]*$"
    ],
    "pickup.datetime": [
     "^[ \\t]*PICK[ \\t]+UP[ \\t]*\\n(?:[ \\t]*\\n)*[ \\t]*([^\\n]*\\d{4}[^\\n]*)$"
    ],
    "return.datetime": [
     "^[ \\t]*DROP[ \\t]+OFF[ \\t]*\\n(?:[ \\t]*\\n)*[ \\t]*([^\\n]*\\d{4}[^\\n]*)$"
    ]
   },
   "blocks": {
    "pickup": {
     "start": [
      "^[ \\t]*(?:pick-?up(?:[ \\t]+(?:location|information|info|details|branch|office))?|pick[ \\t]+up[ \\t]+location)[ \\t]*:?[ \\t]*$"
     ],
     "end": [
      "^[ \\t]*(?:return(?:ed)?|drop[- ]?off)(?:[ \\t]+(?:location|information|info|details|branch|office))?[ \\t]*(?::|$)",
      "^[ \\t]*drop[- ]?off[ \\t]+location[ \\t]*$",
      "^[ \\t]*drop-off:[ \\t]*$",
      "^[ \\t]*(?:(?:return(?:ed)?|drop-?off)(?:[ \\t]+(?:location|information|info|details|branch|office))?|drop[ \\t]+off[ \\t]+location)[ \\t]*:?[ \\t]*$"
     ]
    },
    "return": {
     "start": [
      "^[ \\t]*(?:(?:return(?:ed)?|drop-?off)(?:[ \\t]+(?:location|information|info|details|branch|office))?|drop[ \\t]+off[ \\t]+location)[ \\t]*:?[ \\t]*$"
     ],
     "end": [
      "^[ \\t]*(?:vehicle|your[ \\t]+vehicle|car|charges|your[ \\t]+charges|rental[ \\t]+charges|summary)\\b",
      "^[ \\t]*(?:view|update|a[ \\t]+smooth|estimated)\\b",
      "^[ \\t]*duration:"
     ]
    }
   }
  },
  "budget": {
   "name": "Budget",
   "detect": [
    {
     "re": "\\bBudget\\b",
     "w": 1
    },
    {
     "re": "budget\\.com",
     "w": 2
    },
    {
     "re": "Fastbreak",
     "w": 3
    }
   ],
   "fields": {
