    }
   ],
   "fields": {
    "loyalty.number": [
     {
      "re": "Enterprise[ \\t]+Plus[ \\t]*(?:Number|No\\.?|#)?[ \\t]*(?:[:#]|\\t)[ \\t]*([A-Z0-9][A-Z0-9-]{3,})",
      "set": {
       "loyalty.program": "Enterprise Plus"
      }
     }
    ],
    "agreement": [
     "\\bRA[ \\t]*#[ \\t]*:?[ \\t]*([A-Z0-9]{6,10})\\b",
     "^[ \\t]*Rental[ \\t]+Agreement[ \\t]*#[ \\t]*([A-Z0-9]{6,10})\\b",
     "\\bEnterprise[ \\t]+Rental[ \\t]+Agreement[ \\t]+([A-Z0-9]{6,10})\\b"
    ],
    "total": [
     "Amount[ \\t]+charged[ \\t]+on[^\\n]*?\\([ \\t]*\\$[ \\t]*([\\d,]+\\.\\d{2})[ \\t]*\\)",
     "^[ \\t]*Total[ \\t]{2,}\\$[ \\t]*([\\d,]+\\.\\d{2})[ \\t]*$"
    ],
    "payment.cardBrand": [
     {
      "re": "charged[ \\t]+on[^\\n]*?[ \\t]to[ \\t]+(VISA|MASTERCARD|MASTER[ \\t]CARD|AMEX|AMERICAN[ \\t]+EXPRESS|DISCOVER)[ \\t]*\\((\\d{4})\\)",
      "groups": {
       "payment.cardBrand": 1,
       "payment.cardLast4": 2
      }
     }
    ],
    "mileage.out": [
     "Starting:[ \\t]*(\\d{1,7})[ \\t]+Ending:",
     "\\bODO:[ \\t]*(\\d{1,7})\\b",
     "^[ \\t]*Mileage:[ \\t]*(\\d{1,7})[ \\t]*$"
    ],
    "mileage.in": [
     "Starting:[ \\t]*\\d{1,7}[ \\t]+Ending:[ \\t]*(\\d{1,7})\\b"
    ],
    "fuel.out": [
     "Starting:[ \\t]*(\\d+(?:\\.\\d+)?[ \\t]?g)[ \\t]+Ending:",
     "\\bFuel:[ \\t]*(\\d+(?:\\.\\d+)?[ \\t]?g)\\b"
    ],
    "fuel.in": [
     "Starting:[ \\t]*\\d+(?:\\.\\d+)?[ \\t]?g[ \\t]+Ending:[ \\t]*(\\d+(?:\\.\\d+)?[ \\t]?g)"
    ],
    "vehicle.plate": [
     {
      "re": "\\bLicense:[ \\t]*([A-Z]{2})[ \\t]+([A-Z0-9]{2,8})\\b",
      "groups": {
       "vehicle.plateState": 1,
       "vehicle.plate": 2
      }
     },
     "^[ \\t]*License[ \\t]*#[ \\t]*:[ \\t]*([A-Z0-9]{2,8})\\b"
    ],
    "vehicle.plateState": [
     "^[ \\t]*State/Province:[ \\t]*([A-Z]{2})\\b"
    ],
    "vehicle.description": [
     "^[ \\t]*Make[ \\t]*/[ \\t]*Model[ \\t]*:[ \\t]*([A-Z0-9]+[ \\t]*/[ \\t]*[A-Z0-9]+)[ \\t]*$",
     "^[ \\t]*((?:19|20)\\d{2}[ \\t]+[A-Z]{2,5}[ \\t]+[A-Z0-9]{2,5})[ \\t]",
     "Vehicle[ \\t]+Information[ \\t]*\\n(?:[^\\n]*\\n){0,4}?([A-Z0-9]{2,5})(?:[ \\t]{2,}[^\\n]*)?$"
    ],
    "vehicle.class": [
     "^[ \\t]*Vehicle[ \\t]+Class(?:[ \\t]+Driven)?[ \\t]*\\n(?:[ \\t]*\\n)*[ \\t]*([A-Za-z][A-Za-z ]*?(?:[ \\t]\\d[ \\t]*door|SUV)[^\\n]*?)(?:[ \\t]{2,}[^\\n]*)?$"
    ]
   },
   "preprocess": [
    {
     "re": "^[ \\t]*Dates[ \\t]*&[ \\t]*Times[^\\n]*\\n([^\\t\\n]+\\d{4}[ \\t]+\\d{1,2}:\\d{2}[ \\t]*[AP]M)\\t+([^\\n]+)\\n",
     "to": "Pick-up:\n$1\n$2\n"
    },
    {
     "re": "^(\\(\\d{3}\\)[ \\t]*\\d{3}-\\d{4})[ \\t]*\\n([^\\t\\n]+\\d{4}[ \\t]+\\d{1,2}:\\d{2}[ \\t]*[AP]M)\\t+([^\\n]+)\\n",
     "to": "$1\n\nReturn:\n$2\n$3\n"
    },
    {
     "re": "\\n(?:[ \\t]*\\n)*[ \\t]*(?:Phone|Hours)[ \\t]*\\n(?:[ \\t]*\\n)*[^\\n]*",
     "to": ""
    },
    {
     "re": "\\n(?:[ \\t]*\\n)*[ \\t]*(?:Location|Date[ \\t]*&[ \\t]*Time|Address)[ \\t]*\\n(?:[ \\t]*\\n)*",
     "to": "\n"
    }
   ],
   "columns": [
    {
     "header": "\\bPickup[ \\t]{2,}(?:Intended[ \\t]+)?Return[ \\t]*$",
     "cols": [
      {
       "name": "Pick-up",
       "at": "\\bPickup\\b"
      },
      {
       "name": "Return",
       "at": "(?:Intended[ \\t]+)?Return[ \\t]*$",
       "after": "^Actual[ \\t]+Return[ \\t]*$"
      }
     ],
     "take": 20
    }
   ]
  },
  "national": {
   "name": "National",
   "family": "enterprise",
   "detect": [
    {
     "re": "National[ \\t]+Car[ \\t]+Rental",
