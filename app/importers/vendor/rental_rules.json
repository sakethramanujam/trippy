   ],
   "fields": {
    "loyalty.number": [
     {
      "re": "Gold[ \\t]+Plus[ \\t]+Rewards[ \\t]*(?:Number|No\\.?|#)?[ \\t]*(?:[:#]|\\t)[ \\t]*([A-Z0-9][A-Z0-9-]{3,})",
      "set": {
