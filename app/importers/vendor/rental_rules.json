 },
 "generic": {
  "fields": {
   "agreement": [
    "(?:Rental[ \\t]+Agreement|Rental[ \\t]+Record|Agreement)[ \\t]*(?:Number|No\\.?|#)?[ \\t]*[:#]?[ \\t]*((?=[A-Z-]*\\d)[A-Z0-9][A-Z0-9-]{5,})\\b"
   ],
   "confirmation": [
