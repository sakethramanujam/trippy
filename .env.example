# Trippy self-hosting settings. Copy to .env and edit. Every line is optional.
# Docs: SELF_HOSTING.md. In Portainer, set these as the stack's environment variables instead.

# --- Network -------------------------------------------------------------------
# Host port for the API (the container always listens on 8000).
TRIPPY_PORT=8000
# Which host interface to publish on. 127.0.0.1 = this machine only (use with a reverse proxy,
# Cloudflare Tunnel or Tailscale Serve). 0.0.0.0 = every interface, e.g. your home LAN.
TRIPPY_BIND=127.0.0.1
# Web origins allowed to call the API from a browser (comma-separated). The iOS app ignores this.
TRIPPY_ALLOWED_ORIGINS=
# Set to your reverse proxy's IP (or *) when the proxy runs on another host/container.
# TRIPPY_FORWARDED_ALLOW_IPS=172.18.0.1

# --- Storage -------------------------------------------------------------------
# Where the SQLite database and JWT secret live. A named Docker volume by default;
# set a host path for a bind mount (it must be writable by uid 10001):
#   TRIPPY_DATA=./trippy-data
TRIPPY_DATA=trippy-data

# --- Security ------------------------------------------------------------------
# JWT signing key. Leave empty and Trippy generates one at /data/jwt-secret on first start.
# To set it yourself:  openssl rand -hex 32
# Changing it signs everyone out.
TRIPPY_JWT_SECRET=

# --- Sign-ups ------------------------------------------------------------------
# open   = anyone who can reach the server can create an account
# invite = only people with a one-time invite code from a trip (plus the allowlist)
# closed = nobody new (plus the allowlist)
# The very first account can always sign up, in every mode.
TRIPPY_SIGNUP_MODE=invite
# Comma-separated emails or @domains that may always sign up.
TRIPPY_SIGNUP_ALLOWLIST=

# --- Password reset email (optional) ---------------------------------------------
# Without SMTP, reset codes are printed to the container log:  docker compose logs api
TRIPPY_SMTP_HOST=
TRIPPY_SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
TRIPPY_SMTP_SECURITY=starttls
TRIPPY_SMTP_USERNAME=
TRIPPY_SMTP_PASSWORD=
TRIPPY_SMTP_FROM=Trippy <trippy@example.com>

# --- Email-in: forward bookings to Trippy (optional, off by default) -------------------
# Trippy reads a mailbox YOU own and files confirmations, .ics invites, boarding passes and PDF
# receipts onto the right trip. Nothing goes through a central service. SELF_HOSTING.md → Email-in.
#   off  = disabled (default)
#   imap = poll any IMAP mailbox (Gmail/Outlook app password, Fastmail, Proton Bridge, Dovecot…). No open ports.
#   smtp = Trippy receives mail itself on port 2525 (needs MX + port 25 → see the docs before using).
TRIPPY_INBOUND_MODE=off
# Per-user address; {token} becomes each user's private code (shown in the app, regenerable).
#   plus-addressing:     trips+{token}@example.com     (Gmail, Outlook, Fastmail, most providers)
#   catch-all domain:    {token}@trips.example.com
# Empty = no per-user addresses: mail is matched to the account whose email it's From.
TRIPPY_INBOUND_ADDRESS_TEMPLATE=
# Also accept mail From a user's account email (needs SPF/DKIM/DMARC pass from your mail provider).
TRIPPY_INBOUND_SENDER_MATCH=on
TRIPPY_INBOUND_REQUIRE_AUTH=on
TRIPPY_INBOUND_IMAP_HOST=
# ssl (port 993) | starttls (port 143) | none (only for a local bridge such as Proton Bridge)
TRIPPY_INBOUND_IMAP_SECURITY=ssl
TRIPPY_INBOUND_IMAP_PORT=993
TRIPPY_INBOUND_IMAP_USERNAME=
TRIPPY_INBOUND_IMAP_PASSWORD=
TRIPPY_INBOUND_IMAP_FOLDER=INBOX
# Read mail is marked as read and moved here (created if missing). Empty = only mark as read.
TRIPPY_INBOUND_IMAP_PROCESSED_FOLDER=Trippy-Processed
# Seconds between checks (minimum 30).
TRIPPY_INBOUND_IMAP_INTERVAL=300
# smtp mode: the port inside the container, and the host interface/port docker-compose.smtp.yml publishes.
TRIPPY_INBOUND_SMTP_PORT=2525
TRIPPY_INBOUND_SMTP_BIND=127.0.0.1
TRIPPY_INBOUND_SMTP_HOST_PORT=2525
# Limits: biggest message in bytes, and messages per user per hour.
TRIPPY_INBOUND_MAX_BYTES=15728640
TRIPPY_INBOUND_MAX_PER_HOUR=60

# --- Misc ----------------------------------------------------------------------
TZ=UTC

# Live flight status (optional, off by default). See SELF_HOSTING.md "Live flight status".
# TRIPPY_FLIGHT_STATUS_PROVIDER=aerodatabox   # aerodatabox | aviationstack | aeroapi
# TRIPPY_FLIGHT_STATUS_API_KEY=
# TRIPPY_FLIGHT_STATUS_BASE_URL=              # optional override
# TRIPPY_FLIGHT_STATUS_CACHE_SECONDS=900
